{
  "name": "multiplex",
  "private": true,
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "dev": "bun --filter @multiplex/nextjs dev",
    "build": "bun --filter @multiplex/nextjs build",
    "start": "bun --filter @multiplex/nextjs start",
    "check": "bun --filter @multiplex/nextjs check",
    "lint": "bun --filter @multiplex/nextjs lint",
    "typecheck": "bun --filter @multiplex/nextjs typecheck",
    "format:check": "bun --filter @multiplex/nextjs format:check",
    "format:write": "bun --filter @multiplex/nextjs format:write",
    "db:generate": "bun --filter @multiplex/nextjs db:generate",
    "db:migrate": "bun --filter @multiplex/nextjs db:migrate",
    "db:push": "bun --filter @multiplex/nextjs db:push",
    "db:studio": "bun --filter @multiplex/nextjs db:studio"
  }
}
