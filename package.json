{
  "name": "multiplex",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "lint": "bun --filter @multiplex/web lint && oxlint --ignore-pattern 'apps/web/**' .",
    "lint:fix": "bun --filter @multiplex/web lint:fix && oxlint --fix --ignore-pattern 'apps/web/**' .",
    "format": "bun --filter @multiplex/web format:write && oxfmt --write . '!apps/web/**' '!.agents/**'",
    "format:check": "bun --filter @multiplex/web format:check && oxfmt --check . '!apps/web/**' '!.agents/**'",
    "typecheck": "bun --filter '*' typecheck",
    "check": "bun run lint && bun run format:check && bun run typecheck",
    "test": "bun --filter '*' test",
    "dev": "portless multiplex bun run dev:app",
    "dev:app": "bun --filter @multiplex/web dev",
    "build": "bun --filter @multiplex/web build",
    "start": "bun --filter @multiplex/web start",
    "db:generate": "bun --filter @multiplex/web db:generate",
    "db:migrate": "bun --filter @multiplex/web db:migrate",
    "db:push": "bun --filter @multiplex/web db:push",
    "db:studio": "bun --filter @multiplex/web db:studio",
    "gamecube:setup": "bun --filter @multiplex/gamecube tooling:sync",
    "gamecube:bootstrap": "bun --filter @multiplex/gamecube bootstrap",
    "gamecube:dolphin:bootstrap": "sh apps/gamecube/scripts/bootstrap-dolphin.sh",
    "gamecube:lint": "bun --filter @multiplex/gamecube lint:native",
    "gamecube:test:portable": "bun --filter @multiplex/gamecube test:portable",
    "gamecube:test:sanitize": "bun --filter @multiplex/gamecube test:sanitize",
    "gamecube:meson:setup": "bun --filter @multiplex/gamecube meson:setup",
    "gamecube:analyze": "bun --filter @multiplex/gamecube analyze:native",
    "gamecube:check": "bun run gamecube:setup && bun run gamecube:bootstrap && bun --filter @multiplex/gamecube check:native",
    "gamecube:legacy:dol": "sh apps/gamecube/scripts/run-with-tooling.sh sh apps/gamecube/scripts/build-dol.sh",
    "gamecube:legacy:run": "sh apps/gamecube/scripts/run-dolphin.sh",
    "gamecube:reference:dol": "bun --filter @multiplex/gamecube reference:dol",
    "gamecube:reference:hardware-dol": "sh apps/gamecube/scripts/run-with-tooling.sh sh apps/gamecube/scripts/build-native-reference-hardware-dol.sh",
    "gamecube:symbolize": "sh apps/gamecube/scripts/symbolize-gamecube-crash.sh",
    "gamecube:bba-diagnostics:dol": "sh apps/gamecube/scripts/run-with-tooling.sh sh apps/gamecube/scripts/build-bba-diagnostics-dol.sh",
    "gamecube:bba-diagnostics:clean-dol": "sh apps/gamecube/scripts/run-with-tooling.sh sh apps/gamecube/scripts/build-bba-diagnostics-clean-dol.sh",
    "gamecube:bba-diagnostics:hardware-dol": "sh apps/gamecube/scripts/run-with-tooling.sh sh apps/gamecube/scripts/build-bba-diagnostics-hardware-dol.sh",
    "gamecube:reference:run": "sh apps/gamecube/scripts/run-dolphin.sh apps/gamecube/multiplex-gamecube-native-reference-dolphin.dol",
    "gamecube:launch": "sh apps/gamecube/scripts/launch-multiplex.sh",
    "gamecube:qa": "sh apps/gamecube/scripts/run-with-tooling.sh sh apps/gamecube/scripts/dolphin-qa.sh",
    "gamecube:reference:log-check": "sh apps/gamecube/scripts/check-dolphin-log.sh",
    "gamecube:reference:entropy-qa": "sh apps/gamecube/scripts/run-with-tooling.sh sh apps/gamecube/scripts/dolphin-entropy-qa.sh",
    "gamecube:reference:smoke-player": "sh apps/gamecube/scripts/run-with-tooling.sh sh apps/gamecube/scripts/smoke-dolphin-player.sh",
    "gamecube:reference:smoke-http": "sh apps/gamecube/scripts/run-with-tooling.sh sh apps/gamecube/scripts/smoke-dolphin-http-player.sh",
    "gamecube:reference:smoke-http-tap": "GAMECUBE_DOLPHIN_ROOTLESS_TAP=1 sh apps/gamecube/scripts/run-with-tooling.sh sh apps/gamecube/scripts/smoke-dolphin-http-player.sh",
    "gamecube:reference:plex": "sh apps/gamecube/scripts/run-with-tooling.sh sh apps/gamecube/scripts/run-dolphin-plex.sh",
    "gamecube:raylib:dol": "sh apps/gamecube/scripts/run-with-tooling.sh sh apps/gamecube/scripts/build-raylib-reference-dol.sh",
    "gamecube:raylib:run": "sh apps/gamecube/scripts/run-dolphin.sh apps/gamecube/multiplex-gamecube-raylib-reference.dol",
    "wii:reference:dol": "bun --filter @multiplex/wii reference:dol",
    "wii:reference:smoke-player": "MULTIPLEX_REFERENCE_DOL=apps/wii/multiplex-wii-native-reference.dol MULTIPLEX_REFERENCE_BUILD_SCRIPT=../../wii/scripts/build-reference-dol.sh MULTIPLEX_CONSOLE_NAME=Wii MULTIPLEX_CONTROLLER_PIPE=multiplex-wii1 sh apps/gamecube/scripts/smoke-dolphin-player.sh",
    "wii:reference:plex": "MULTIPLEX_REFERENCE_DOL=apps/wii/multiplex-wii-native-reference.dol MULTIPLEX_REFERENCE_BUILD_SCRIPT=../../wii/scripts/build-reference-dol.sh MULTIPLEX_CONSOLE_NAME=Wii MULTIPLEX_CONTROLLER_PIPE=multiplex-wii1 MULTIPLEX_DOLPHIN_NETWORK=native sh apps/gamecube/scripts/run-dolphin-plex.sh"
  },
  "devDependencies": {
    "oxfmt": "^0.26.0",
    "oxlint": "^1.41.0",
    "portless": "^0.15.4"
  },
  "overrides": {
    "defu": ">=6.1.5 <7"
  },
  "catalog": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "better-auth": "1.6.13",
    "typescript": "^5.8.3",
    "zod": "^3.24.2",
    "effect": "4.0.0-beta.59",
    "@effect/atom-react": "4.0.0-beta.59"
  }
}
