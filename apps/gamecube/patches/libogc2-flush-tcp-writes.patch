+static void flush_tcp_output(void *context)
+{
+	struct netconn *conn = context;
+	if(conn && conn->type==NETCONN_TCP && conn->pcb.tcp)
+		tcp_output(conn->pcb.tcp);
+}
+
+s32 net_flush(s32 s)
+{
+	struct netsocket *sock = get_socket(s);
+	if(!sock) return -EBADF;
+	return net_callback(flush_tcp_output,sock->conn);
+}
