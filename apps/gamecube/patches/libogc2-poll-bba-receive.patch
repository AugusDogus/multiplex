 }
 
+extern void bba_poll_receive(void) __attribute__((weak));
+
 s32 net_recvfrom(s32 s,void *mem,size_t len,u32 flags,struct sockaddr *from,socklen_t *fromlen)
 {
 	struct netsocket *sock;
@@ -1850,6 +1852,10 @@ s32 net_recvfrom(s32 s,void *mem,size_t len,u32 flags,struct sockaddr *from,sock
 	sock = get_socket(s);
 	if(!sock) return -EBADF;
+	if(!sock->lastdata && bba_poll_receive) {
+		bba_poll_receive();
+		LWP_YieldThread();
+	}
 
 	if(sock->lastdata)
 		buf = sock->lastdata;
 	else {
@@ -2082,6 +2088,11 @@ s32 net_select(s32 maxfdp1,fd_set *readset,fd_set *writeset,fd_set *exceptset,st
 	struct netselect_cb sel_cb;
 	struct netselect_cb *psel_cb;
 	
+	if(bba_poll_receive) {
+		bba_poll_receive();
+		LWP_YieldThread();
