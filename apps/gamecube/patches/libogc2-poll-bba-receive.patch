diff --git a/lwip/arch/gc/netif/gcif.c b/lwip/arch/gc/netif/gcif.c
index 51e61b6..0a720bd 100644
--- a/lwip/arch/gc/netif/gcif.c
+++ b/lwip/arch/gc/netif/gcif.c
@@ -887,6 +887,23 @@ static s32 bba_event_handler(s32 nChn,s32 nDev)
 	return 1;
 }
 
+void bba_poll_receive(void)
+{
+	u8 status;
+
+	if(!gc_netif) return;
+	if(EXI_Lock(EXI_CHANNEL_0,EXI_DEVICE_2,NULL)==0) return;
+
+	status = bba_cmd_in8(0x03);
+	if((status&0x80) || (bba_in8(BBA_IR)&bba_in8(BBA_IMR))) {
+		bba_cmd_out8(0x02,BBA_CMD_IRMASKALL);
+		bba_interrupt(gc_netif);
+		if(status&0x80) bba_cmd_out8(0x03,0x80);
+		bba_cmd_out8(0x02,BBA_CMD_IRMASKNONE);
+	}
+	EXI_Unlock(EXI_CHANNEL_0);
+}
+
 err_t bba_init(struct netif *dev)
 {
 	err_t ret;
