# GameCube host that presents Native SDK's reference-rendered RGBA framebuffer
# directly with GX. This intentionally remains separate from the command-based
# approximation and the experimental raylib/OpenGX presenter.

.SUFFIXES:

ifeq ($(strip $(DEVKITPPC)),)
$(error "DEVKITPPC must point to the devkitPPC toolchain")
endif

APP_ROOT := $(abspath $(dir $(firstword $(MAKEFILE_LIST))))

include $(DEVKITPRO)/libogc2/gamecube_rules

REFERENCE_VARIANT ?= dolphin
ifeq ($(REFERENCE_VARIANT),dolphin)
else ifeq ($(REFERENCE_VARIANT),hardware)
else ifeq ($(REFERENCE_VARIANT),clean)
else
$(error REFERENCE_VARIANT must be dolphin, hardware, or clean)
endif
TARGET := multiplex-gamecube-native-reference-$(REFERENCE_VARIANT)
BUILD := build-native-reference
SOURCES := host-reference-gx host-reference
MPLAYER_ROOT := $(APP_ROOT)/.mplayer-ce-libogc2/mplayer
FFMPEG_ROOT := $(MPLAYER_ROOT)/ffmpeg
MBEDTLS_ROOT := $(APP_ROOT)/.mbedtls-stage
INCLUDES := host host-reference host-reference-gx generated

CFLAGS := -g -gdwarf-4 -gstrict-dwarf -O2 -Wall -Wextra -Werror \
	$(MACHDEP) $(INCLUDE)
CXXFLAGS := $(CFLAGS)
LDFLAGS := -g $(MACHDEP) -Wl,-Map,$(notdir $@).map
LIBS := $(CORE_LIBRARY) -lavcodec -lavutil -lmbedtls -lmbedx509 \
	-lmbedcrypto -lbba -logc -lm

ifneq ($(BUILD),$(notdir $(CURDIR)))

export OUTPUT := $(APP_ROOT)/$(TARGET)
export VPATH := $(foreach dir,$(SOURCES),$(APP_ROOT)/$(dir))
export DEPSDIR := $(APP_ROOT)/$(BUILD)

CFILES := $(foreach dir,$(SOURCES),$(notdir $(wildcard $(APP_ROOT)/$(dir)/*.c)))
OFILES_SOURCES := $(CFILES:.c=.o)
OFILES_ASSETS := multiplex-dvd-demo-program.o
export CORE_LIBRARY := $(APP_ROOT)/zig-out/lib/libmultiplex-gamecube-core.a
export OFILES := $(OFILES_SOURCES) $(OFILES_ASSETS)

export INCLUDE := $(foreach dir,$(INCLUDES),-I$(APP_ROOT)/$(dir)) \
	-I$(FFMPEG_ROOT) \
	-I$(MBEDTLS_ROOT)/include \
	-I$(APP_ROOT)/$(BUILD) \
	-I$(LIBOGC_INC)
export LIBPATHS := -L$(LIBOGC_LIB) \
	-L$(FFMPEG_ROOT)/libavcodec \
	-L$(FFMPEG_ROOT)/libavutil \
	-L$(MBEDTLS_ROOT)/lib
export LD := $(CC)

.PHONY: all clean $(BUILD)

all: $(BUILD)

$(BUILD): $(CORE_LIBRARY)
	@[ -d $@ ] || mkdir -p $@
	@$(MAKE) --no-print-directory -C $(BUILD) \
		-f $(APP_ROOT)/Makefile.reference.gamecube

$(CORE_LIBRARY):
	@echo "Missing $@; run bun run gamecube:check first." >&2
	@false

clean:
	@echo clean ...
	@rm -rf $(BUILD) $(OUTPUT).elf $(OUTPUT).dol

else

.DEFAULT_GOAL := $(OUTPUT).dol

# OFILES is exported by the outer make. OFILES_SOURCES is not, so deriving
# dependencies from it here silently produced an empty list and allowed stale
# objects after shared header changes.
DEPENDS := $(OFILES:.o=.d)

multiplex-dvd-demo-program.s: $(APP_ROOT)/assets/multiplex-dvd-demo.mpg
	$(SILENTMSG) embedding ... $(notdir $<)
	$(SILENTCMD)bin2s -H multiplex-dvd-demo-program.h $< > $@

multiplex-dvd-demo-program.h: multiplex-dvd-demo-program.s

main.o: media-source.h multiplex-dvd-demo-program.h \
	$(APP_ROOT)/generated/geist_atlas.h
app_services.o app_services_auth.o app_services_catalog.o \
	app_services_details.o app_services_discovery.o app_services_playback.o \
	app_services_playback_resolution.o app_services_scheduler.o \
	app_services_watch_directory.o \
	app_services_watch_disabled.o app_services_watch_syncplay.o \
	app_services_watch_together.o: media-source.h
http_client.o: media-source.h
tls_client.o: tls-ca.h

media-source.h:
	@echo "Missing $@; run scripts/build-native-reference-dol.sh." >&2
	@false

tls-ca.h:
	@echo "Missing $@; run scripts/build-native-reference-dol.sh." >&2
	@false

$(OUTPUT).dol: $(OUTPUT).elf
$(OUTPUT).elf: $(OFILES) $(CORE_LIBRARY) $(LIBOGC_LIB)/libbba.a \
	$(MBEDTLS_ROOT)/lib/libmbedtls.a \
	$(MBEDTLS_ROOT)/lib/libmbedx509.a \
	$(MBEDTLS_ROOT)/lib/libmbedcrypto.a

-include $(DEPENDS)

endif
