{
  "name": "@multiplex/desktop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist-electron/main.cjs",
  "scripts": {
    "build": "vp pack",
    "dev": "bun run --parallel dev:bundle dev:electron",
    "dev:bundle": "vp pack --watch",
    "dev:electron": "node scripts/dev-electron.mjs",
    "start": "node scripts/start-electron.mjs",
    "test": "bun test",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@effect/platform-node": "4.0.0-rc.108",
    "@multiplex/desktop-contracts": "workspace:*",
    "@multiplex/libmpv": "workspace:*",
    "effect": "catalog:",
    "electron": "41.5.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "catalog:",
    "vite": "npm:@voidzero-dev/vite-plus-core@0.2.2",
    "vite-plus": "0.2.2"
  },
  "productName": "Multiplex"
}
