<column padding="24" gap="16" background="background">
  <row cross="center">
    <text size="heading">Multiplex</text>
    <spacer grow="1" />
    <if test="{pairingLinked}">
      <badge variant="outline">START Watch Together</badge>
    </if>
    <badge variant="secondary">GameCube spike</badge>
  </row>
  <separator />

  <if test="{screen == 'pairing'}">
    <column grow="1" main="center" cross="center" gap="12" label="Pair with Multiplex">
      <if test="{pairingEnabled}">
        <if test="{pairingWaiting}">
          <badge variant="secondary">Link this GameCube</badge>
          <text foreground="text_muted">On another device, open</text>
          <text size="heading">{pairingUrl}</text>
          <text foreground="text_muted">and enter this code</text>
          <panel width="220" padding="18" background="surface" border-color="border" radius="lg">
            <column cross="center">
              <text size="heading">{pairingCode}</text>
            </column>
          </panel>
          <text size="sm" foreground="text_muted">Waiting for your Multiplex account...</text>
        </if>
        <if test="{pairingLinked}">
          <text size="heading">GameCube linked</text>
          <text foreground="text_muted">Loading your Multiplex home...</text>
        </if>
        <if test="{pairingUnavailable}">
          <text size="heading">Multiplex is unavailable</text>
          <text foreground="text_muted">Check the gateway connection. This screen will retry automatically.</text>
        </if>
      </if>
      <if test="{pairingDemo}">
        <text size="heading">Connect to your Multiplex gateway</text>
        <text foreground="text_muted">Catalog and media stay behind one console-friendly protocol.</text>
        <button variant="primary" on-press="connect_demo">Open {gatewayName}</button>
      </if>
    </column>
  </if>

  <if test="{screen == 'home'}">
    <column grow="1" gap="8">
      <row cross="center">
        <column gap="1">
          <text size="heading">{visibleRowTitle}</text>
          <text size="sm" foreground="text_muted">{gatewayName}</text>
        </column>
        <spacer grow="1" />
        <badge variant="secondary">Row {rowNumber} of {rowCount}</badge>
      </row>
      <row grow="1" gap="8">
        <for each="visibleItems" as="item" key="ratingKey">
          <panel width="140" grow="1" padding="7" background="surface" border-color="border" radius="lg" on-press="open_item:{item.id}" label="{item.title}">
            <column grow="1" gap="4">
              <image image="{item.imageId}" width="126" height="190" label="{item.title}" />
              <progress value="{item.progressPercent}" height="4" />
              <text size="sm" wrap="false">{item.title}</text>
              <text size="sm" foreground="text_muted" wrap="false">{item.subtitle}</text>
            </column>
          </panel>
        </for>
      </row>
      <if test="{hasMultipleRows}">
        <row gap="8" main="center">
          <button variant="secondary" on-press="previous_row">Previous row</button>
          <button variant="secondary" on-press="next_row">Next row</button>
          <if test="{hasLibraries}">
            <button variant="primary" on-press="open_libraries">Libraries</button>
          </if>
          <button variant="secondary" on-press="open_search">Search</button>
        </row>
      </if>
    </column>
  </if>

  <if test="{screen == 'libraries'}">
    <column grow="1" gap="14">
      <row cross="center">
        <button width="90" variant="ghost" on-press="back">Home</button>
        <column gap="1">
          <text size="heading">Libraries</text>
          <text size="sm" foreground="text_muted">{gatewayName}</text>
        </column>
        <spacer grow="1" />
        <button variant="secondary" on-press="open_search">Search</button>
      </row>
      <row grow="1" gap="10" cross="center">
        <for each="libraries" as="library" key="id">
          <panel width="138" grow="1" padding="16" background="surface" border-color="border" radius="lg" on-press="open_library:{library.id}" label="{library.title}">
            <column grow="1" main="center" cross="center" gap="8">
              <badge variant="secondary">{library.typeLabel}</badge>
              <text size="heading">{library.title}</text>
              <text size="sm" foreground="text_muted">Browse all</text>
            </column>
          </panel>
        </for>
      </row>
    </column>
  </if>

  <if test="{screen == 'search'}">
    <column grow="1" gap="12">
      <row cross="center">
        <button width="90" variant="ghost" on-press="back">Home</button>
        <column gap="1">
          <text size="heading">Search Plex</text>
          <text size="sm" foreground="text_muted">Across {gatewayName}</text>
        </column>
        <spacer grow="1" />
        <badge variant="secondary">Z opens search</badge>
      </row>
      <panel padding="14" background="surface" border-color="border" radius="lg">
        <row cross="center" gap="10">
          <text size="heading">{searchPrompt}</text>
          <spacer grow="1" />
          <badge variant="secondary">L delete</badge>
          <badge variant="primary">R search</badge>
        </row>
      </panel>
      <column grow="1" main="center" gap="8">
        <row gap="6" main="center">
          <for each="keyboardRowOne" as="key" key="id">
            <button width="54" variant="secondary" on-press="search_key:{key.id}">{key.label}</button>
          </for>
        </row>
        <row gap="6" main="center">
          <for each="keyboardRowTwo" as="key" key="id">
            <button width="54" variant="secondary" on-press="search_key:{key.id}">{key.label}</button>
          </for>
        </row>
        <row gap="6" main="center">
          <for each="keyboardRowThree" as="key" key="id">
            <button width="54" variant="secondary" on-press="search_key:{key.id}">{key.label}</button>
          </for>
        </row>
      </column>
      <row main="center" gap="8">
        <text size="sm" foreground="text_muted">D-pad moves · A enters · B cancels · L deletes · R searches</text>
      </row>
    </column>
  </if>

  <if test="{screen == 'search_results'}">
    <column grow="1" gap="8">
      <row cross="center">
        <button width="90" variant="ghost" on-press="back">Search</button>
        <column gap="1">
          <text size="heading">Results for {searchQuery}</text>
          <text size="sm" foreground="text_muted">Movies, TV, music, and collections</text>
        </column>
      </row>
      <if test="{searchHasResults}">
        <row grow="1" gap="8">
          <for each="searchItems" as="item" key="ratingKey">
            <panel width="140" grow="1" padding="7" background="surface" border-color="border" radius="lg" on-press="open_item:{item.id}" label="{item.title}">
              <column grow="1" gap="4">
                <image image="{item.imageId}" width="126" height="190" label="{item.title}" />
                <text size="sm" wrap="false">{item.title}</text>
                <text size="sm" foreground="text_muted" wrap="false">{item.subtitle}</text>
              </column>
            </panel>
          </for>
        </row>
      </if>
      <if test="{searchLoading}">
        <column grow="1" main="center" cross="center">
          <text foreground="text_muted">Searching all Plex libraries...</text>
        </column>
      </if>
      <if test="{searchNoResults}">
        <column grow="1" main="center" cross="center" gap="8">
          <text size="heading">No results</text>
          <text foreground="text_muted">Try another title, person, or collection.</text>
        </column>
      </if>
    </column>
  </if>

  <if test="{screen == 'browse'}">
    <column grow="1" gap="8">
      <row cross="center">
        <button width="90" variant="ghost" on-press="back">Libraries</button>
        <column gap="1">
          <text size="heading">{selectedLibraryTitle}</text>
          <text size="sm" foreground="text_muted">{browseTotal} items</text>
        </column>
        <spacer grow="1" />
        <badge variant="secondary">Page {browsePageNumber} of {browsePageCount}</badge>
      </row>
      <if test="{browseLoaded}">
        <row grow="1" gap="8">
          <for each="browseItems" as="item" key="ratingKey">
            <panel width="140" grow="1" padding="7" background="surface" border-color="border" radius="lg" on-press="open_item:{item.id}" label="{item.title}">
              <column grow="1" gap="4">
                <image image="{item.imageId}" width="126" height="190" label="{item.title}" />
                <progress value="{item.progressPercent}" height="4" />
                <text size="sm" wrap="false">{item.title}</text>
                <text size="sm" foreground="text_muted" wrap="false">{item.subtitle}</text>
              </column>
            </panel>
          </for>
        </row>
        <row gap="8" main="center">
          <if test="{browseHasPrevious}">
            <button variant="secondary" on-press="browse_previous">Previous page</button>
          </if>
          <if test="{browseHasNext}">
            <button variant="primary" on-press="browse_next">Next page</button>
          </if>
        </row>
      </if>
      <if test="{browseLoading}">
        <column grow="1" main="center" cross="center">
          <text foreground="text_muted">Loading library page...</text>
        </column>
      </if>
    </column>
  </if>

  <if test="{screen == 'watch_together_invite'}">
    <column grow="1" gap="14">
      <row cross="center">
        <button width="90" variant="ghost" on-press="back">Back</button>
        <column gap="1">
          <text size="heading">Invite a friend</text>
          <text size="sm" foreground="text_muted">Choose who should join {selectedTitle}</text>
        </column>
        <spacer grow="1" />
        <badge variant="secondary">Plex friends</badge>
      </row>
      <if test="{watchTogetherHasInvitees}">
        <row cross="center">
          <text size="sm" foreground="text_muted">Invitees</text>
          <spacer grow="1" />
          <badge variant="secondary">Page {watchTogetherInviteePageNumber} of {watchTogetherInviteePageCount}</badge>
        </row>
        <row grow="1" gap="10" cross="center">
          <for each="visibleWatchTogetherInvitees" as="invitee" key="id">
            <panel width="138" grow="1" padding="16" background="surface" border-color="border" radius="lg" on-press="invite_watch_together:{invitee.id}" label="{invitee.title}">
              <column grow="1" main="center" cross="center" gap="8">
                <badge variant="secondary">Plex user</badge>
                <text size="heading" wrap="true">{invitee.title}</text>
                <text size="sm" foreground="text_muted">Invite and create room</text>
              </column>
            </panel>
          </for>
        </row>
        <row gap="8" main="center">
          <if test="{watchTogetherInviteesHasPrevious}">
            <button variant="secondary" on-press="watch_together_invitees_previous">Previous</button>
          </if>
          <if test="{watchTogetherInviteesHasNext}">
            <button variant="primary" on-press="watch_together_invitees_next">Next</button>
          </if>
        </row>
      </if>
      <if test="{watchTogetherNoInvitees}">
        <column grow="1" main="center" cross="center" gap="10">
          <text size="heading">No friends available</text>
          <text foreground="text_muted">Add a Plex friend before creating a shared room.</text>
        </column>
      </if>
      <if test="{watchTogetherInviteesUnavailable}">
        <column grow="1" main="center" cross="center" gap="10">
          <text size="heading">Friends are unavailable</text>
          <text foreground="text_muted">Multiplex could not load your Plex friends right now.</text>
        </column>
      </if>
      <if test="{watchTogetherInviteesLoading}">
        <column grow="1" main="center" cross="center">
          <text foreground="text_muted">Loading Plex friends...</text>
        </column>
      </if>
    </column>
  </if>

  <if test="{screen == 'watch_together'}">
    <column grow="1" gap="14">
      <row cross="center">
        <button width="90" variant="ghost" on-press="back">Home</button>
        <column gap="1">
          <text size="heading">Watch Together</text>
          <text size="sm" foreground="text_muted">Rooms from your Multiplex account</text>
        </column>
        <spacer grow="1" />
        <badge variant="secondary">Shared web API</badge>
      </row>
      <if test="{watchTogetherHasRooms}">
        <row grow="1" gap="10" cross="center">
          <for each="watchTogetherRooms" as="room" key="id">
            <panel width="138" grow="1" padding="16" background="surface" border-color="border" radius="lg" on-press="join_watch_together:{room.id}" label="{room.title}">
              <column grow="1" main="center" cross="center" gap="8">
                <badge variant="secondary">{room.participantCount} viewers</badge>
                <text size="heading" wrap="true">{room.title}</text>
                <text size="sm" foreground="text_muted">Plex Syncplay room</text>
              </column>
            </panel>
          </for>
        </row>
      </if>
      <if test="{watchTogetherNoRooms}">
        <column grow="1" main="center" cross="center" gap="10">
          <text size="heading">No active rooms</text>
          <text foreground="text_muted">Create a Watch Together room in Multiplex and it will appear here.</text>
        </column>
      </if>
      <if test="{watchTogetherUnavailable}">
        <column grow="1" main="center" cross="center" gap="10">
          <text size="heading">Rooms are unavailable</text>
          <text foreground="text_muted">Multiplex could not load Watch Together right now.</text>
        </column>
      </if>
      <if test="{watchTogetherLoading}">
        <column grow="1" main="center" cross="center">
          <text foreground="text_muted">Creating Watch Together room...</text>
        </column>
      </if>
      <if test="{watchTogetherCreateFailed}">
        <column grow="1" main="center" cross="center" gap="10">
          <text size="heading">Room creation failed</text>
          <text foreground="text_muted">Return to the item and try again.</text>
        </column>
      </if>
    </column>
  </if>

  <if test="{screen == 'watch_together_room'}">
    <column grow="1" gap="14">
      <row cross="center">
        <button width="90" variant="ghost" on-press="back">Rooms</button>
        <column gap="1">
          <text size="heading">{selectedWatchTogetherRoomTitle}</text>
          <text size="sm" foreground="text_muted">{selectedWatchTogetherParticipantCount} invited viewers</text>
        </column>
        <spacer grow="1" />
        <badge variant="secondary">Plex Syncplay</badge>
      </row>
      <if test="{watchTogetherJoining}">
        <column grow="1" main="center" cross="center" gap="10">
          <text size="heading">Joining room...</text>
          <text foreground="text_muted">Opening the native Syncplay connection.</text>
        </column>
      </if>
      <if test="{watchTogetherConnected}">
        <column grow="1" main="center" cross="center" gap="10">
          <text size="heading">Waiting for everyone</text>
          <badge variant="secondary">{watchTogetherPresentCount} of {selectedWatchTogetherParticipantCount} viewers present</badge>
          <text foreground="text_muted">Playback starts after every invited viewer joins the lobby.</text>
        </column>
      </if>
      <if test="{watchTogetherJoinFailed}">
        <column grow="1" main="center" cross="center" gap="10">
          <text size="heading">Could not join room</text>
          <text foreground="text_muted">Return to the room list and try again.</text>
        </column>
      </if>
    </column>
  </if>

  <if test="{screen == 'details'}">
    <column grow="1" gap="10">
      <row cross="center">
        <button width="90" variant="ghost" on-press="back">Back</button>
        <spacer grow="1" />
        <badge variant="secondary">{gatewayName}</badge>
      </row>
      <if test="{detailsLoading}">
        <column grow="1" main="center" cross="center" gap="8">
          <text size="heading">{selectedTitle}</text>
          <text foreground="text_muted">Loading full Plex details...</text>
        </column>
      </if>
      <if test="{detailsLoaded}">
        <panel grow="1" padding="16" background="surface" border-color="border" radius="lg">
          <row grow="1" gap="18">
            <column width="160" gap="8">
              <image image="{selectedImageId}" width="160" height="240" label="{selectedTitle}" />
              <if test="{hasResume}">
                <badge variant="secondary">Resume available</badge>
              </if>
            </column>
            <column grow="1" gap="8">
              <row gap="6" cross="center">
                <badge variant="secondary">{detailsType}</badge>
                <badge variant="outline">{detailsLibrary}</badge>
                <if test="{detailsHasContentRating}">
                  <badge variant="outline">{detailsContentRating}</badge>
                </if>
              </row>
              <text size="heading">{selectedTitle}</text>
              <if test="{detailsHasSecondary}">
                <text foreground="text_muted">{detailsSecondary}</text>
              </if>
              <if test="{detailsHasFacts}">
                <text size="sm" foreground="text_muted">{detailsFacts}</text>
              </if>
              <if test="{detailsHasDirectors}">
                <text size="sm">{detailsDirectors}</text>
              </if>
              <if test="{detailsHasGenres}">
                <text size="sm" foreground="text_muted">{detailsGenres}</text>
              </if>
              <if test="{detailsHasSummary}">
                <text size="sm" foreground="text_muted" wrap="true">{detailsSummary}</text>
              </if>
              <spacer grow="1" />
              <row gap="10">
                <if test="{detailsPlayable}">
                  <button variant="primary" on-press="play">Play</button>
                </if>
                <if test="{pairingLinked}">
                  <button variant="secondary" on-press="create_watch_together">Host Watch Together</button>
                </if>
                <if test="{detailsUnplayable}">
                  <badge variant="secondary">Choose a playable child</badge>
                </if>
                <button variant="secondary" on-press="back">Return</button>
              </row>
            </column>
          </row>
        </panel>
      </if>
    </column>
  </if>

  <if test="{screen == 'player'}">
    <column grow="1" gap="12">
      <row cross="center">
        <column gap="2">
          <text size="heading">{selectedTitle}</text>
          <text foreground="text_muted">Live GameCube media surface</text>
        </column>
        <spacer grow="1" />
        <if test="{watchTogetherActive}">
          <if test="{watchTogetherConnected}">
            <badge variant="secondary">{watchTogetherPresentCount} of {selectedWatchTogetherParticipantCount} viewers</badge>
          </if>
          <if test="{watchTogetherDisconnected}">
            <badge variant="outline">Room disconnected</badge>
          </if>
        </if>
        <if test="{watchTogetherInactive}">
          <badge variant="secondary">Streaming from {gatewayName}</badge>
        </if>
      </row>
      <if test="{playbackLoading}">
        <column grow="1" main="center" cross="center" gap="8">
          <text size="heading">Preparing playback...</text>
          <text foreground="text_muted">Requesting the selected Plex session.</text>
        </column>
      </if>
      <if test="{playbackLoaded}">
        <video src="demo://multiplex-test-card" autoplay loop muted grow="1" label="{selectedTitle}"/>
        <row gap="10" main="center">
          <button variant="primary" on-press="toggle_playback">Play / Pause</button>
          <if test="{watchTogetherActive}">
            <button variant="secondary" on-press="leave_watch_together">Leave room</button>
            <button variant="secondary" on-press="reconnect_watch_together">Reconnect</button>
          </if>
          <if test="{watchTogetherInactive}">
            <button variant="secondary" on-press="back">Back to details</button>
          </if>
          <badge variant="outline">L -30s · R +30s</badge>
        </row>
      </if>
    </column>
  </if>
</column>
