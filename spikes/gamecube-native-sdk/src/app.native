<stack>
  <if test="{screen == 'player'}">
    <stack>
      <media-surface surface="{videoSurface}" grow="1" label="{selectedTitle}" />
      <column padding="16" cross="center">
        <spacer grow="1" />
        <if test="{playbackLoading}">
          <panel padding="12" background="scrim" radius="lg">
            <row main="center" cross="center" gap="8">
              <text>Preparing playback...</text>
              <text size="sm" foreground="text_muted">Requesting the selected Plex session.</text>
            </row>
          </panel>
        </if>
        <if test="{playbackLoaded}">
          <panel width="620" padding="10" background="surface" border-color="border" radius="sm" label="Player controls">
            <row gap="8" cross="center">
              <column width="220" gap="2">
                <if test="{detailsHasHierarchy}">
                  <text size="sm" wrap="false">{detailsSecondary}</text>
                  <text size="sm" foreground="text_muted" wrap="false">{detailsHierarchy} - {selectedTitle}</text>
                </if>
                <else>
                  <text size="sm" wrap="false">{selectedTitle}</text>
                  <if test="{detailsHasSecondary}">
                    <text size="sm" foreground="text_muted" wrap="false">{detailsSecondary}</text>
                  </if>
                </else>
                <text size="sm" foreground="text_muted">{playbackElapsedMinutes}:{pad(playbackElapsedSeconds, 2)} / -{playbackRemainingMinutes}:{pad(playbackRemainingSeconds, 2)}</text>
              </column>
              <spacer grow="1" />
              <row gap="6" cross="center">
                <button width="44" icon="skip-back" variant="ghost" on-press="play_previous" disabled="{playbackEpisodeNavigationDisabled}" label="Previous"></button>
                <button width="44" icon="app:back-10" variant="ghost" on-press="seek_backward" label="Back 10 seconds"></button>
                <button width="48" icon="{playbackToggleIcon}" variant="primary" on-press="toggle_playback" label="Play or pause"></button>
                <button width="44" icon="app:forward-30" variant="ghost" on-press="seek_forward" label="Forward 30 seconds"></button>
                <button width="44" icon="skip-forward" variant="ghost" on-press="play_next" disabled="{playbackEpisodeNavigationDisabled}" label="Next"></button>
                <button width="44" icon="app:stop" variant="ghost" on-press="stop_playback" label="Stop"></button>
                <button width="44" icon="settings" variant="ghost" on-press="open_player_settings" label="Playback settings"></button>
              </row>
            </row>
          </panel>
        </if>
      </column>
    </stack>
  </if>
  <else>
<column padding="20" gap="12" background="background">
  <row cross="center">
    <row width="180" cross="center" gap="8">
      <icon name="app:multiplex" width="22" height="22" foreground="text" label="Multiplex" />
      <text size="heading">Multiplex</text>
    </row>
    <row grow="1" main="center" cross="center">
      <if test="{hasPageTitle}">
        <text size="heading">{pageTitle}</text>
      </if>
    </row>
    <row width="180" cross="center">
      <spacer grow="1" />
      <if test="{pairingLinked}">
        <button-group>
          <button width="32" size="sm" icon="folder" variant="secondary" on-press="open_libraries" label="Libraries"></button>
          <button width="32" size="sm" icon="search" variant="secondary" on-press="open_search" label="Search"></button>
        </button-group>
      </if>
    </row>
  </row>
  <separator />

  <if test="{screen == 'pairing'}">
    <column grow="1" main="center" cross="center" gap="12" label="Pair with Multiplex">
      <if test="{pairingEnabled}">
        <if test="{pairingConnecting}">
          <text size="heading">Connecting</text>
          <text foreground="text_muted">A Broadband Adapter and Ethernet connection are required.</text>
        </if>
        <if test="{pairingWaiting}">
          <badge variant="secondary">Link this GameCube</badge>
          <text foreground="text_muted">On another device, open</text>
          <text size="heading">{pairingUrl}</text>
          <text foreground="text_muted">and enter this code</text>
          <panel width="220" padding="18" background="surface" border-color="border" radius="lg">
            <column cross="center">
              <text size="heading">{pairingCode}</text>
            </column>
          </panel>
          <text size="sm" foreground="text_muted">Waiting for your Multiplex account...</text>
        </if>
        <if test="{pairingLinked}">
          <text size="heading">Starting Multiplex</text>
          <text foreground="text_muted">Loading your Plex home...</text>
        </if>
        <if test="{pairingUnavailable}">
          <text size="heading">Network unavailable</text>
          <text foreground="text_muted">Check Ethernet and Plex. Multiplex will keep trying.</text>
        </if>
      </if>
      <if test="{pairingDemo}">
        <text size="heading">Connect to your Multiplex gateway</text>
        <text foreground="text_muted">Catalog and media stay behind one console-friendly protocol.</text>
        <button variant="primary" on-press="connect_demo">Open {gatewayName}</button>
      </if>
    </column>
  </if>

  <if test="{screen == 'home'}">
    <column grow="1" gap="5">
      <row cross="center">
        <text label="{visibleRowTitle}"><span weight="bold">{visibleRowTitle}</span></text>
      </row>
      <row height="150" gap="8" main="center" cross="start">
        <row gap="8" main="center">
          <for each="visibleItems" as="item" key="ratingKey">
            <column width="68" gap="2" on-press="open_item:{item.id}" label="{item.title}">
              <image image="{item.imageId}" width="68" height="102" radius="lg" label="{item.title}" />
              <if test="{item.progressPercent > 0 and item.progressPercent < 100}">
                <progress value="{item.progressPercent / 100}" height="3" />
              </if>
              <else>
                <spacer height="3" />
              </else>
              <text size="sm" wrap="false">{item.title}</text>
              <text size="sm" foreground="text_muted" wrap="false">{item.secondary}</text>
              <if test="{item.hasHierarchy}">
                <text size="sm" foreground="text_muted" wrap="false">{item.hierarchy}</text>
              </if>
            </column>
          </for>
        </row>
      </row>
      <if test="{homeHasNextShelf}">
        <row cross="center">
          <text label="{homeNextShelfTitle}"><span weight="bold">{homeNextShelfTitle}</span></text>
        </row>
        <row height="150" gap="8" main="center" cross="start">
          <for each="homeNextShelfItems" as="item" key="ratingKey">
            <column width="68" gap="2">
              <image image="{item.imageId}" width="68" height="102" radius="lg" label="{item.title}" />
              <if test="{item.progressPercent > 0 and item.progressPercent < 100}">
                <progress value="{item.progressPercent / 100}" height="3" />
              </if>
              <else>
                <spacer height="3" />
              </else>
              <text size="sm" wrap="false">{item.title}</text>
              <text size="sm" foreground="text_muted" wrap="false">{item.secondary}</text>
              <if test="{item.hasHierarchy}">
                <text size="sm" foreground="text_muted" wrap="false">{item.hierarchy}</text>
              </if>
            </column>
          </for>
        </row>
      </if>
      <if test="{homeHasFollowingShelf}">
        <row cross="center">
          <text label="{homeFollowingShelfTitle}"><span weight="bold">{homeFollowingShelfTitle}</span></text>
        </row>
      </if>
    </column>
  </if>

  <if test="{screen == 'libraries'}">
    <column grow="1" gap="14">
      <row cross="center">
        <button width="42" size="sm" icon="app:home" variant="ghost" on-press="back" label="Home"></button>
        <spacer grow="1" />
      </row>
      <row grow="1" gap="10" cross="center">
        <for each="libraries" as="library" key="id">
          <panel width="138" grow="1" padding="14" background="surface" border-color="border" radius="lg" on-press="open_library:{library.id}" label="{library.title}">
            <column grow="1" main="center" cross="center" gap="8">
              <icon name="folder" width="22" height="22" foreground="text_muted" label="Library" />
              <text wrap="true" text-alignment="center">{library.title}</text>
            </column>
          </panel>
        </for>
      </row>
    </column>
  </if>

  <if test="{screen == 'search'}">
    <column grow="1" gap="12">
      <row cross="center">
        <button width="42" size="sm" icon="app:home" variant="ghost" on-press="back" label="Home"></button>
        <spacer grow="1" />
      </row>
      <panel padding="14" background="surface" border-color="border" radius="lg" label="Search input">
        <row cross="center" gap="10">
          <icon name="search" width="20" height="20" foreground="text_muted" label="Search" />
          <if test="{searchHasQuery}">
            <text size="heading"><span>{searchBeforeCursor}</span><span foreground="info">|</span><span>{searchAfterCursor}</span></text>
          </if>
          <else>
            <text size="heading" foreground="text_muted">Search</text>
          </else>
          <spacer grow="1" />
        </row>
      </panel>
      <column grow="1" main="center" gap="8">
        <row gap="6" main="center">
          <for each="keyboardRowOne" as="key" key="id">
            <button width="48" variant="secondary" on-press="search_key:{key.id}">{key.label}</button>
          </for>
        </row>
        <row gap="6" main="center">
          <for each="keyboardRowTwo" as="key" key="id">
            <button width="48" variant="secondary" on-press="search_key:{key.id}">{key.label}</button>
          </for>
        </row>
        <row gap="6" main="center">
          <for each="keyboardRowThree" as="key" key="id">
            <button width="48" variant="secondary" on-press="search_key:{key.id}">{key.label}</button>
          </for>
        </row>
      </column>
    </column>
  </if>

  <if test="{screen == 'search_results'}">
    <column grow="1" gap="8">
      <row cross="center">
        <button width="42" size="sm" icon="app:back" variant="ghost" on-press="back" label="Back to search"></button>
        <column gap="1">
          <text size="sm">Results for {searchQuery}</text>
          <text size="sm" foreground="text_muted">Movies, TV, music, and collections</text>
        </column>
      </row>
      <if test="{searchHasResults}">
        <column grow="1" gap="8">
          <column height="42" gap="2">
            <text size="heading" wrap="false">{catalogPreviewTitle}</text>
            <row gap="8" cross="center">
              <text size="sm" foreground="text_muted" wrap="false">{catalogPreviewSecondary}</text>
              <if test="{catalogPreviewHasHierarchy}">
                <text size="sm" foreground="text_muted">{catalogPreviewHierarchy}</text>
              </if>
              <if test="{catalogPreviewHasProgress}">
                <text size="sm" foreground="text_muted">{catalogPreviewRemainingMinutes} min left</text>
              </if>
            </row>
          </column>
          <row grow="1" gap="8" main="center">
            <for each="searchItems" as="item" key="ratingKey">
              <column width="124" gap="4" on-press="open_item:{item.id}" label="{item.title}">
                <image image="{item.imageId}" width="124" height="186" radius="lg" label="{item.title}" />
                <text size="sm" wrap="false">{item.title}</text>
                <text size="sm" foreground="text_muted" wrap="false">{item.secondary}</text>
                <if test="{item.hasHierarchy}">
                  <text size="sm" foreground="text_muted" wrap="false">{item.hierarchy}</text>
                </if>
              </column>
            </for>
          </row>
        </column>
      </if>
      <if test="{searchLoading}">
        <column grow="1" main="center" cross="center">
          <text foreground="text_muted">Searching all Plex libraries...</text>
        </column>
      </if>
      <if test="{searchFailed}">
        <column grow="1" main="center" cross="center" gap="8">
          <text size="heading">Search unavailable</text>
          <text foreground="text_muted">Return to Search and try again.</text>
        </column>
      </if>
      <if test="{searchNoResults}">
        <column grow="1" main="center" cross="center" gap="8">
          <text size="heading">No results</text>
          <text foreground="text_muted">Try another title, person, or collection.</text>
        </column>
      </if>
    </column>
  </if>

  <if test="{screen == 'browse'}">
    <column grow="1" gap="8">
      <row cross="center">
        <button width="42" size="sm" icon="app:back" variant="ghost" on-press="back" label="Back to libraries"></button>
        <spacer grow="1" />
        <text size="sm" foreground="text_muted">{browseTotal} items</text>
        <text size="sm" foreground="text_muted">Page {browsePageNumber} of {browsePageCount}</text>
      </row>
      <if test="{browseLoaded}">
        <column grow="1" gap="8">
          <column height="42" gap="2">
            <text size="heading" wrap="false">{catalogPreviewTitle}</text>
            <row gap="8" cross="center">
              <text size="sm" foreground="text_muted" wrap="false">{catalogPreviewSecondary}</text>
              <if test="{catalogPreviewHasHierarchy}">
                <text size="sm" foreground="text_muted">{catalogPreviewHierarchy}</text>
              </if>
              <if test="{catalogPreviewHasProgress}">
                <text size="sm" foreground="text_muted">{catalogPreviewRemainingMinutes} min left</text>
              </if>
            </row>
          </column>
          <row grow="1" gap="8" main="center" cross="start">
            <column width="34" height="186" main="center">
              <button width="34" size="sm" icon="chevron-left" variant="ghost" on-press="browse_previous" disabled="{browsePreviousDisabled}" label="Previous page"></button>
            </column>
            <row grow="1" gap="8" main="center">
              <for each="browseItems" as="item" key="ratingKey">
                <column width="124" gap="4" on-press="open_item:{item.id}" label="{item.title}">
                  <image image="{item.imageId}" width="124" height="186" radius="lg" label="{item.title}" />
                  <if test="{item.progressPercent > 0 and item.progressPercent < 100}">
                    <progress value="{item.progressPercent / 100}" height="4" />
                  </if>
                  <else>
                    <spacer height="4" />
                  </else>
                  <text size="sm" wrap="false">{item.title}</text>
                  <text size="sm" foreground="text_muted" wrap="false">{item.secondary}</text>
                  <if test="{item.hasHierarchy}">
                    <text size="sm" foreground="text_muted" wrap="false">{item.hierarchy}</text>
                  </if>
                </column>
              </for>
            </row>
            <column width="34" height="186" main="center">
              <button width="34" size="sm" icon="chevron-right" variant="ghost" on-press="browse_next" disabled="{browseNextDisabled}" label="Next page"></button>
            </column>
          </row>
        </column>
      </if>
      <if test="{browseLoading}">
        <column grow="1" main="center" cross="center">
          <text foreground="text_muted">Loading library page...</text>
        </column>
      </if>
      <if test="{browseFailed}">
        <column grow="1" main="center" cross="center" gap="8">
          <text size="heading">Library unavailable</text>
          <text foreground="text_muted">Return to Libraries and try again.</text>
        </column>
      </if>
    </column>
  </if>

  <if test="{screen == 'watch_together_invite'}">
    <column grow="1" gap="14">
      <row cross="center">
        <button width="42" size="sm" icon="app:back" variant="ghost" on-press="back" label="Back"></button>
        <column gap="1">
          <text size="sm" foreground="text_muted">Choose who should join {selectedTitle}</text>
        </column>
        <spacer grow="1" />
      </row>
      <if test="{watchTogetherHasInvitees}">
        <row cross="center">
          <text size="sm" foreground="text_muted">Invitees</text>
          <spacer grow="1" />
          <badge variant="secondary">Page {watchTogetherInviteePageNumber} of {watchTogetherInviteePageCount}</badge>
        </row>
        <row grow="1" gap="10" cross="center">
          <for each="visibleWatchTogetherInvitees" as="invitee" key="id">
            <panel width="138" grow="1" padding="16" background="surface" border-color="border" radius="lg" on-press="invite_watch_together:{invitee.id}" label="{invitee.title}">
              <column grow="1" main="center" cross="center" gap="8">
                <badge variant="secondary">Plex user</badge>
                <text size="heading" wrap="true">{invitee.title}</text>
                <text size="sm" foreground="text_muted">Invite and create room</text>
              </column>
            </panel>
          </for>
        </row>
        <row gap="8" main="center">
          <if test="{watchTogetherInviteesHasPrevious}">
            <button variant="secondary" on-press="watch_together_invitees_previous">Previous</button>
          </if>
          <if test="{watchTogetherInviteesHasNext}">
            <button variant="primary" on-press="watch_together_invitees_next">Next</button>
          </if>
        </row>
      </if>
      <if test="{watchTogetherNoInvitees}">
        <column grow="1" main="center" cross="center" gap="10">
          <text size="heading">No friends available</text>
          <text foreground="text_muted">Add a Plex friend before creating a shared room.</text>
        </column>
      </if>
      <if test="{watchTogetherInviteesUnavailable}">
        <column grow="1" main="center" cross="center" gap="10">
          <text size="heading">Friends are unavailable</text>
          <text foreground="text_muted">Multiplex could not load your Plex friends right now.</text>
        </column>
      </if>
      <if test="{watchTogetherInviteesLoading}">
        <column grow="1" main="center" cross="center">
          <text foreground="text_muted">Loading Plex friends...</text>
        </column>
      </if>
    </column>
  </if>

  <if test="{screen == 'watch_together'}">
    <column grow="1" gap="14">
      <row cross="center">
        <button width="42" size="sm" icon="app:home" variant="ghost" on-press="back" label="Home"></button>
        <column gap="1">
          <text size="sm" foreground="text_muted">Rooms from your Multiplex account</text>
        </column>
        <spacer grow="1" />
      </row>
      <if test="{watchTogetherHasRooms}">
        <row grow="1" gap="10" cross="center">
          <for each="watchTogetherRooms" as="room" key="id">
            <panel width="138" grow="1" padding="16" background="surface" border-color="border" radius="lg" on-press="join_watch_together:{room.id}" label="{room.title}">
              <column grow="1" main="center" cross="center" gap="8">
                <badge variant="secondary">{room.participantCount} viewers</badge>
                <text size="heading" wrap="true">{room.title}</text>
              </column>
            </panel>
          </for>
        </row>
      </if>
      <if test="{watchTogetherNoRooms}">
        <column grow="1" main="center" cross="center" gap="10">
          <text size="heading">No active rooms</text>
          <text foreground="text_muted">Create a Watch Together room in Multiplex and it will appear here.</text>
        </column>
      </if>
      <if test="{watchTogetherUnavailable}">
        <column grow="1" main="center" cross="center" gap="10">
          <text size="heading">Rooms are unavailable</text>
          <text foreground="text_muted">Multiplex could not load Watch Together right now.</text>
        </column>
      </if>
      <if test="{watchTogetherLoading}">
        <column grow="1" main="center" cross="center">
          <text foreground="text_muted">Creating Watch Together room...</text>
        </column>
      </if>
      <if test="{watchTogetherCreateFailed}">
        <column grow="1" main="center" cross="center" gap="10">
          <text size="heading">Room creation failed</text>
          <text foreground="text_muted">Return to the item and try again.</text>
        </column>
      </if>
      <if test="{watchTogetherDisbandFailed}">
        <column grow="1" main="center" cross="center" gap="10">
          <text size="heading">Room disband failed</text>
          <text foreground="text_muted">The room is still available. Re-enter it and try again.</text>
        </column>
      </if>
    </column>
  </if>

  <if test="{screen == 'watch_together_room'}">
    <column grow="1" gap="14">
      <row cross="center">
        <button width="42" size="sm" icon="app:back" variant="ghost" on-press="back" label="Back to rooms"></button>
        <column gap="1">
          <text size="sm" foreground="text_muted">{selectedWatchTogetherParticipantCount} invited viewers</text>
        </column>
        <spacer grow="1" />
      </row>
      <if test="{watchTogetherJoining}">
        <column grow="1" main="center" cross="center" gap="10">
          <text size="heading">Joining room...</text>
          <text foreground="text_muted">Opening the native Syncplay connection.</text>
        </column>
      </if>
      <if test="{watchTogetherConnected}">
        <column grow="1" main="center" cross="center" gap="10">
          <text size="heading">Waiting for everyone</text>
          <badge variant="secondary">{watchTogetherPresentCount} of {selectedWatchTogetherParticipantCount} viewers present</badge>
          <text foreground="text_muted">Playback starts after every invited viewer joins the lobby.</text>
        </column>
      </if>
      <if test="{watchTogetherJoinFailed}">
        <column grow="1" main="center" cross="center" gap="10">
          <text size="heading">Could not join room</text>
          <text foreground="text_muted">Return to the room list and try again.</text>
        </column>
      </if>
    </column>
  </if>

  <if test="{screen == 'details'}">
    <column grow="1" gap="8">
      <row cross="center">
        <button width="42" size="sm" icon="app:back" variant="ghost" on-press="back" label="Back"></button>
      </row>
      <if test="{detailsLoading}">
        <row grow="1" gap="18" padding="8">
          <column grow="1" main="center" gap="8">
            <text size="heading">{selectedTitle}</text>
            <text size="sm" foreground="text_muted">Loading details and playback options...</text>
          </column>
          <column width="132" main="center">
            <image image="{selectedImageId}" width="132" height="198" radius="lg" label="{selectedTitle}" />
          </column>
        </row>
      </if>
      <if test="{detailsLoaded}">
        <column grow="1" gap="10">
          <row gap="18" padding="8">
            <column grow="1" gap="7">
              <if test="{detailsHasHierarchy}">
                <text size="heading" wrap="false">{detailsSecondary}</text>
                <text wrap="false">{selectedTitle}</text>
                <text size="sm" foreground="text_muted" wrap="false">{detailsHierarchy}</text>
              </if>
              <else>
                <text size="heading" wrap="false">{selectedTitle}</text>
                <if test="{detailsHasSecondary}">
                  <text foreground="text_muted" wrap="false">{detailsSecondary}</text>
                </if>
              </else>
              <row gap="6" cross="center">
                <if test="{detailsHasContentRating}">
                  <badge variant="outline">{detailsContentRating}</badge>
                </if>
                <if test="{detailsHasFacts}">
                  <text size="sm" foreground="text_muted">{detailsFacts}</text>
                </if>
              </row>
              <if test="{detailsPlayable}">
                <row gap="8">
                  <button size="sm" icon="play" variant="primary" on-press="play">{detailsPlayLabel}</button>
                  <button width="38" size="sm" icon="check-circle" variant="ghost" on-press="mark_watched" label="Mark as Watched"></button>
                  <button width="38" size="sm" icon="ellipsis" variant="ghost" on-press="open_start_menu" label="More actions"></button>
                </row>
                <if test="{detailsHasSummary}">
                  <text foreground="text_muted" wrap="true">{detailsSummary}</text>
                </if>
                <if test="{detailsHasDirectors}">
                  <row gap="4" cross="center">
                    <text size="sm" foreground="text_muted">Directed by</text>
                    <text size="sm">{detailsDirectors}</text>
                  </row>
                </if>
              </if>
            </column>
            <column width="132" gap="5">
              <image image="{selectedImageId}" width="132" height="198" radius="lg" label="{selectedTitle}" />
              <if test="{detailsHasProgress}">
                <progress value="{detailsProgressPercent / 100}" height="4" />
              </if>
              <else>
                <spacer height="4" />
              </else>
            </column>
          </row>
          <if test="{detailsChildrenLoading}">
            <text size="sm" foreground="text_muted">Loading seasons and episodes...</text>
          </if>
          <if test="{detailsHasChildren}">
            <column gap="6">
              <row cross="center">
                <text><span weight="bold">Episodes &amp; seasons</span></text>
                <spacer grow="1" />
                <text size="sm" foreground="text_muted">Page {detailsChildrenPageNumber} of {detailsChildrenPageCount}</text>
              </row>
              <row gap="6" cross="center">
                <button width="32" size="sm" icon="chevron-left" variant="ghost" on-press="details_children_previous" disabled="{detailsChildrenPreviousDisabled}" label="Previous page"></button>
                <row grow="1" gap="6">
                  <for each="detailsChildren" as="child" key="ratingKey">
                    <panel width="112" height="68" padding="8" background="scrim" border-color="border" radius="lg" on-press="open_details_child:{child.id}" label="{child.title}">
                      <column grow="1" main="center" gap="4">
                        <text size="sm" wrap="false">{child.title}</text>
                        <text size="sm" foreground="text_muted" wrap="false">{child.subtitle}</text>
                        <if test="{child.progressPercent > 0 and child.progressPercent < 100}">
                          <progress value="{child.progressPercent / 100}" height="3" />
                        </if>
                      </column>
                    </panel>
                  </for>
                </row>
                <button width="32" size="sm" icon="chevron-right" variant="ghost" on-press="details_children_next" disabled="{detailsChildrenNextDisabled}" label="Next page"></button>
              </row>
            </column>
          </if>
          <if test="{detailsNoChildren}">
            <text size="sm" foreground="text_muted">No playable seasons or episodes were returned by Plex.</text>
          </if>
        </column>
      </if>
    </column>
  </if>

</column>
  </else>
  <if test="{startMenuOpen}">
    <column grow="1" main="center" cross="center" background="scrim">
      <panel width="310" height="390" background="surface" border-color="border" radius="lg" label="Multiplex menu">
          <column padding="16" gap="8">
            <text size="heading">Multiplex</text>
            <text size="sm" foreground="text_muted">Choose an action</text>
            <separator />
            <if test="{screen == 'details' and detailsPlayable}">
              <button size="sm" icon="play" variant="primary" on-press="start_menu_play">{detailsPlayLabel}</button>
              <button size="sm" icon="check-circle" variant="secondary" on-press="start_menu_mark_watched">Mark as Watched</button>
            </if>
            <if test="{screen == 'details' and detailsPlayable}">
              <button size="sm" variant="secondary" on-press="start_menu_create_watch_together">Host Watch Together</button>
            </if>
            <button size="sm" icon="menu" variant="secondary" on-press="start_menu_watch_together">Watch Together rooms</button>
            <button size="sm" icon="folder" variant="secondary" on-press="start_menu_libraries">Libraries</button>
            <button size="sm" icon="search" variant="secondary" on-press="start_menu_search">Search</button>
            <spacer grow="1" />
            <button size="sm" variant="ghost" on-press="close_start_menu">Close</button>
          </column>
      </panel>
    </column>
  </if>
  <if test="{playerSettingsOpen}">
    <column grow="1" main="center" cross="center" background="scrim">
      <panel width="310" height="230" background="surface" border-color="border" radius="lg" label="Playback settings">
          <column padding="16" gap="8">
            <text size="heading">Playback settings</text>
            <separator />
            <if test="{subtitlesAvailable}">
              <text size="sm" foreground="text_muted">Subtitles</text>
              <if test="{subtitlesEnabled}">
                <button size="sm" icon="file-text" variant="primary" on-press="cycle_subtitles">{selectedSubtitleLabel}</button>
              </if>
              <else>
                <button size="sm" icon="file-text" variant="secondary" on-press="cycle_subtitles">Off</button>
              </else>
            </if>
            <else>
              <text size="sm" foreground="text_muted">No subtitles are available for this item.</text>
            </else>
            <if test="{watchTogetherActive}">
              <button size="sm" variant="secondary" on-press="leave_watch_together">Leave Watch Together</button>
              <button size="sm" variant="secondary" on-press="reconnect_watch_together">Reconnect room</button>
              <if test="{watchTogetherHost}">
                <button size="sm" variant="destructive" on-press="disband_watch_together">Disband room</button>
              </if>
            </if>
            <spacer grow="1" />
            <button size="sm" variant="ghost" on-press="close_player_settings">Close</button>
          </column>
      </panel>
    </column>
  </if>
  <if test="{toastVisible}">
    <column padding="20" cross="center">
      <spacer grow="1" />
      <panel padding="10" background="surface" border-color="border" radius="lg" label="Notification">
        <text size="sm">{toastMessage}</text>
      </panel>
    </column>
  </if>
</stack>
