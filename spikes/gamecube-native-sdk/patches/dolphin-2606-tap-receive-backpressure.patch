+  const u32 rx_start = page_ptr(BBA_BP) << 8;
+  const u32 rx_end = page_ptr(BBA_RHBP) << 8;
+  u32 copied = 0;
+  while (copied < size)
+  {
+    u32 chunk = size - copied;
+    const bool in_receive_ring = rx_start < rx_end && transfer.address >= rx_start &&
+                                 transfer.address < rx_end;
+    if (in_receive_ring)
+      chunk = std::min(chunk, rx_end - transfer.address);
+
+    memory.CopyToEmu(addr + copied, &mBbaMem[transfer.address], chunk);
+    copied += chunk;
+    transfer.address += chunk;
+    if (in_receive_ring && transfer.address == rx_end)
+      transfer.address = rx_start;
+  }
