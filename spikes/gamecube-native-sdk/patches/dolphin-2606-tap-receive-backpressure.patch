@@ -129,0 +132,28 @@ void CEXIETHERNET::TAPNetworkInterface::ReadThreadHandler(TAPNetworkInterface* s
+    if (!self->readEnabled.IsSet())
+    {
+      std::this_thread::sleep_for(std::chrono::milliseconds(1));
+      continue;
+    }
+
+    const u16 bp = self->m_eth_ref->page_ptr(BBA_BP);
+    const u16 rp = self->m_eth_ref->page_ptr(BBA_RRP);
+    const u16 wp = self->m_eth_ref->page_ptr(BBA_RWP);
+    const u16 rhbp = self->m_eth_ref->page_ptr(BBA_RHBP);
+    if (bp >= BBA_NUM_PAGES || rhbp > BBA_NUM_PAGES || bp >= rhbp || rp < bp || rp >= rhbp ||
+        wp < bp || wp >= rhbp)
+    {
+      std::this_thread::sleep_for(std::chrono::milliseconds(1));
+      continue;
+    }
+    const u16 receive_pages = rhbp - bp;
+    const u16 used_pages = wp >= rp ? wp - rp : (rhbp - rp) + (wp - bp);
+
+    // Match the receive-ring backpressure used by the built-in BBA backend.
+    // A full-size Ethernet frame consumes up to seven 256-byte pages, so stop
+    // reading TAP before the emulated adapter can overwrite unread packets.
+    if (used_pages + 7 >= receive_pages)
+    {
+      std::this_thread::sleep_for(std::chrono::milliseconds(1));
+      continue;
+    }
+
