@@ -129,0 +132,27 @@ void CEXIETHERNET::TAPNetworkInterface::ReadThreadHandler(TAPNetworkInterface* s
+    if (!self->readEnabled.IsSet())
+    {
+      std::this_thread::sleep_for(std::chrono::milliseconds(1));
+      continue;
+    }
+
+    const u16 bp = self->m_eth_ref->page_ptr(BBA_BP);
+    const u16 rp = self->m_eth_ref->page_ptr(BBA_RRP);
+    const u16 wp = self->m_eth_ref->page_ptr(BBA_RWP);
+    const u16 rhbp = self->m_eth_ref->page_ptr(BBA_RHBP);
+    if (bp >= BBA_NUM_PAGES || rhbp > BBA_NUM_PAGES || bp >= rhbp || rp < bp || rp >= rhbp ||
+        wp < bp || wp >= rhbp)
+    {
+      std::this_thread::sleep_for(std::chrono::milliseconds(1));
+      continue;
+    }
+    const u16 used_pages = wp >= rp ? wp - rp : (rhbp - rp) + (wp - bp);
+
+    // The receive interrupt and descriptor update are observed by the emulated
+    // CPU asynchronously. Admit one frame at a time so a fast TAP producer
+    // cannot append another descriptor before libogc retires the current one.
+    if (used_pages != 0)
+    {
+      std::this_thread::sleep_for(std::chrono::milliseconds(1));
+      continue;
+    }
+
