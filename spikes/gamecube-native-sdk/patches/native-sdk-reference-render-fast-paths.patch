+/// Axis-aligned rounded-rect geometry with normalization and clamped
+/// per-corner radii prepared once per command instead of once per pixel.
+const ReferenceRoundedRect = struct {
+    rect: geometry.RectF,
+    half_width: f32,
+    half_height: f32,
+    top_left: f32,
+    top_right: f32,
+    bottom_right: f32,
+    bottom_left: f32,
+
+    fn init(rect: geometry.RectF, radius: Radius) ReferenceRoundedRect {
+        const normalized = rect.normalized();
+        const max_radius = @min(normalized.width, normalized.height) * 0.5;
+        return .{
+            .rect = normalized,
+            .half_width = normalized.width * 0.5,
+            .half_height = normalized.height * 0.5,
+            .top_left = std.math.clamp(nonNegative(radius.top_left), 0, max_radius),
+            .top_right = std.math.clamp(nonNegative(radius.top_right), 0, max_radius),
+            .bottom_right = std.math.clamp(nonNegative(radius.bottom_right), 0, max_radius),
+            .bottom_left = std.math.clamp(nonNegative(radius.bottom_left), 0, max_radius),
+        };
+    }
+
+    fn cornerRadius(self: ReferenceRoundedRect, dx: f32, dy: f32) f32 {
+        return if (dx < 0)
+            (if (dy < 0) self.top_left else self.bottom_left)
+        else
+            (if (dy < 0) self.top_right else self.bottom_right);
+    }
+
+    fn coverage(self: ReferenceRoundedRect, point: geometry.PointF) f32 {
+        if (self.rect.isEmpty()) return 0;
+        const dx = point.x - (self.rect.x + self.half_width);
+        const dy = point.y - (self.rect.y + self.half_height);
+        const corner_radius = self.cornerRadius(dx, dy);
+        const qx = @abs(dx) - self.half_width + corner_radius;
+        const qy = @abs(dy) - self.half_height + corner_radius;
+        if (@max(qx, qy) <= -0.5) return 1;
+        if (qx - corner_radius >= 0.5 or qy - corner_radius >= 0.5) return 0;
+        const mx = @max(qx, 0);
+        const my = @max(qy, 0);
+        const signed_distance = @sqrt(mx * mx + my * my) + @min(@max(qx, qy), 0) - corner_radius;
+        return std.math.clamp(0.5 - signed_distance, 0, 1);
+    }
+
+    fn contains(self: ReferenceRoundedRect, point: geometry.PointF) bool {
+        if (!self.rect.containsPoint(point)) return false;
+        if (point.x < self.rect.x + self.top_left and point.y < self.rect.y + self.top_left) {
+            return referencePointInCorner(point, geometry.PointF.init(self.rect.x + self.top_left, self.rect.y + self.top_left), self.top_left);
+        }
+        if (point.x >= self.rect.maxX() - self.top_right and point.y < self.rect.y + self.top_right) {
+            return referencePointInCorner(point, geometry.PointF.init(self.rect.maxX() - self.top_right, self.rect.y + self.top_right), self.top_right);
