# GameCube host that presents Native SDK's reference-rendered RGBA framebuffer
# through the pinned raylib4Consoles GameCube backend.

.SUFFIXES:

ifeq ($(strip $(DEVKITPPC)),)
$(error "DEVKITPPC must point to the devkitPPC toolchain")
endif

SPIKE_ROOT := $(abspath $(dir $(firstword $(MAKEFILE_LIST))))

include $(DEVKITPRO)/libogc2/gamecube_rules

TARGET := multiplex-gamecube-raylib-reference
BUILD := build-raylib-reference
SOURCES := host-raylib
INCLUDES := host .raylib/src .opengx/src .opengx/include

CFLAGS := -g -O2 -Wall -Wextra $(MACHDEP) $(INCLUDE)
CXXFLAGS := $(CFLAGS)
LDFLAGS := -g $(MACHDEP) -Wl,-Map,$(notdir $@).map
LIBS := $(CORE_LIBRARY) -lraylib -lopengx -logc -lm

ifneq ($(BUILD),$(notdir $(CURDIR)))

export OUTPUT := $(SPIKE_ROOT)/$(TARGET)
export VPATH := $(foreach dir,$(SOURCES),$(SPIKE_ROOT)/$(dir))
export DEPSDIR := $(SPIKE_ROOT)/$(BUILD)

CFILES := $(foreach dir,$(SOURCES),$(notdir $(wildcard $(SPIKE_ROOT)/$(dir)/*.c)))
OFILES_SOURCES := $(CFILES:.c=.o)
export CORE_LIBRARY := $(SPIKE_ROOT)/zig-out/lib/libmultiplex-gamecube-core.a
export RAYLIB_LIBRARY := $(SPIKE_ROOT)/.raylib/src/libraylib.a
export OPENGX_LIBRARY := $(SPIKE_ROOT)/.opengx-build/libopengx.a
export OFILES := $(OFILES_SOURCES)

export INCLUDE := $(foreach dir,$(INCLUDES),-I$(SPIKE_ROOT)/$(dir)) \
	-I$(SPIKE_ROOT)/$(BUILD) \
	-I$(LIBOGC_INC) \
	-I$(SPIKE_ROOT)/.opengx/src \
	-I$(SPIKE_ROOT)/.opengx/include
export LIBPATHS := -L$(LIBOGC_LIB) \
	-L$(SPIKE_ROOT)/.raylib/src \
	-L$(SPIKE_ROOT)/.opengx-build
export LD := $(CC)

.PHONY: all clean $(BUILD)

all: $(BUILD)

$(BUILD): $(CORE_LIBRARY) $(RAYLIB_LIBRARY) $(OPENGX_LIBRARY)
	@[ -d $@ ] || mkdir -p $@
	@$(MAKE) --no-print-directory -C $(BUILD) -f $(SPIKE_ROOT)/Makefile.raylib.gamecube

$(CORE_LIBRARY):
	@echo "Missing $@; run bun run spike:gamecube:check first." >&2
	@false

$(RAYLIB_LIBRARY):
	@echo "Missing $@; run the raylib reference build script first." >&2
	@false

$(OPENGX_LIBRARY):
	@echo "Missing $@; run the raylib reference build script first." >&2
	@false

clean:
	@echo clean ...
	@rm -rf $(BUILD) $(OUTPUT).elf $(OUTPUT).dol

else

DEPENDS := $(OFILES_SOURCES:.o=.d)

$(OUTPUT).dol: $(OUTPUT).elf
$(OUTPUT).elf: $(OFILES) $(CORE_LIBRARY) $(RAYLIB_LIBRARY) $(OPENGX_LIBRARY)

-include $(DEPENDS)

endif
