node_modules/
.pnp
.pnp.js

# testing
coverage/

# database
db.sqlite
*.sqlite-journal

# next.js
.next/
out/
next-env.d.ts

# production
build/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# local env files
# do not commit any .env files to git, except for the .env.example file. https://create.t3.gg/en/usage/env-variables#using-environment-variables
.env
.env*.local

# vercel
.vercel

# typescript
*.tsbuildinfo

# idea files
.idea

# llms
llms/

# Ephemeral agent/implementation plans — keep out of the repo.
# `plans/effect-v4-migration.md` is the tracked exception.
plans/*
!plans/effect-v4-migration.md

# playwright
