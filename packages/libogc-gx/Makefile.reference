# Console host that presents Native SDK's reference-rendered RGBA framebuffer
# directly with GX. This intentionally remains separate from the command-based
# approximation and the experimental raylib/OpenGX presenter.
# MULTIPLEX_PLATFORM selects the GameCube or Wii target; platform differences
# stay in the blocks below.

.SUFFIXES:

ifeq ($(strip $(DEVKITPPC)),)
$(error "DEVKITPPC must point to the devkitPPC toolchain")
endif

RUNTIME_ROOT := $(abspath $(dir $(firstword $(MAKEFILE_LIST))))
REPO_ROOT := $(abspath $(RUNTIME_ROOT)/../..)
UI_ROOT := $(REPO_ROOT)/packages/console-ui
TOOLCHAIN_ROOT := $(REPO_ROOT)/apps/gamecube

MULTIPLEX_PLATFORM ?= gamecube
ifeq ($(MULTIPLEX_PLATFORM),gamecube)
include $(DEVKITPRO)/libogc2/gamecube_rules
REFERENCE_VARIANT ?= dolphin
ifeq ($(REFERENCE_VARIANT),dolphin)
else ifeq ($(REFERENCE_VARIANT),hardware)
else ifeq ($(REFERENCE_VARIANT),clean)
else
$(error REFERENCE_VARIANT must be dolphin, hardware, or clean)
endif
TARGET := multiplex-gamecube-native-reference-$(REFERENCE_VARIANT)
OUTPUT_ROOT := $(REPO_ROOT)/apps/gamecube
CONSOLE_SOURCE := $(OUTPUT_ROOT)/reference-main.c
BUILD := build-native-reference
BUILD_COMMAND := bun run gamecube:reference:dol
PLATFORM_LIBS := -lbba
PLATFORM_ELF_DEPS := $(LIBOGC_LIB)/libbba.a
else ifeq ($(MULTIPLEX_PLATFORM),wii)
include $(DEVKITPRO)/libogc2/wii_rules
TARGET := multiplex-wii-native-reference
OUTPUT_ROOT := $(REPO_ROOT)/apps/wii
CONSOLE_SOURCE := $(OUTPUT_ROOT)/reference-main.c
BUILD := build-native-reference-wii
BUILD_COMMAND := bun run wii:reference:dol
PLATFORM_LIBS := -lwiiuse -lbte
PLATFORM_ELF_DEPS :=
else
$(error MULTIPLEX_PLATFORM must be gamecube or wii)
endif

BUILD_ROOT := $(OUTPUT_ROOT)/$(BUILD)
MPLAYER_ROOT := $(TOOLCHAIN_ROOT)/.mplayer-ce-libogc2/mplayer
FFMPEG_ROOT := $(MPLAYER_ROOT)/ffmpeg
MBEDTLS_ROOT := $(TOOLCHAIN_ROOT)/.mbedtls-stage
INCLUDES := host generated

CFLAGS := -g -gdwarf-4 -gstrict-dwarf -O2 -Wall -Wextra -Werror \
	$(MACHDEP) $(INCLUDE)
CXXFLAGS := $(CFLAGS)
LDFLAGS := -g $(MACHDEP) -Wl,-Map,$(notdir $@).map
LIBS := $(CORE_LIBRARY) -lavcodec -lavutil -lmbedtls -lmbedx509 \
	-lmbedcrypto $(PLATFORM_LIBS) -logc -lm

ifneq ($(BUILD),$(notdir $(CURDIR)))

export OUTPUT := $(OUTPUT_ROOT)/$(TARGET)
export VPATH := $(RUNTIME_ROOT)/src \
	$(dir $(CONSOLE_SOURCE)) \
	$(UI_ROOT)/reference-frame
export DEPSDIR := $(BUILD_ROOT)

CFILES := $(notdir $(wildcard $(RUNTIME_ROOT)/src/*.c)) \
	$(notdir $(CONSOLE_SOURCE)) \
	$(notdir $(wildcard $(UI_ROOT)/reference-frame/*.c))
OFILES_SOURCES := $(CFILES:.c=.o)
OFILES_ASSETS := multiplex-dvd-demo-program.o
export CORE_LIBRARY := $(UI_ROOT)/zig-out/lib/libmultiplex-console-ui.a
export OFILES := $(OFILES_SOURCES) $(OFILES_ASSETS)

export INCLUDE := $(foreach dir,$(INCLUDES),-I$(TOOLCHAIN_ROOT)/$(dir)) \
	-I$(RUNTIME_ROOT)/src \
	-I$(UI_ROOT)/include \
	-I$(UI_ROOT)/reference-frame \
	-I$(FFMPEG_ROOT) \
	-I$(MBEDTLS_ROOT)/include \
	-I$(BUILD_ROOT) \
	-I$(LIBOGC_INC)
export LIBPATHS := -L$(LIBOGC_LIB) \
	-L$(FFMPEG_ROOT)/libavcodec \
	-L$(FFMPEG_ROOT)/libavutil \
	-L$(MBEDTLS_ROOT)/lib
export LD := $(CC)

.PHONY: all clean $(BUILD)

all: $(BUILD)

$(BUILD): $(CORE_LIBRARY)
	@[ -d $(BUILD_ROOT) ] || mkdir -p $(BUILD_ROOT)
	@$(MAKE) --no-print-directory -C $(BUILD_ROOT) \
		-f $(RUNTIME_ROOT)/Makefile.reference \
		MULTIPLEX_PLATFORM=$(MULTIPLEX_PLATFORM)

$(CORE_LIBRARY):
	@echo "Missing $@; run bun run gamecube:check first." >&2
	@false

clean:
	@echo clean ...
	@rm -rf $(BUILD_ROOT) $(OUTPUT).elf $(OUTPUT).dol

else

.DEFAULT_GOAL := $(OUTPUT).dol

# OFILES is exported by the outer make. OFILES_SOURCES is not, so deriving
# dependencies from it here silently produced an empty list and allowed stale
# objects after shared header changes.
DEPENDS := $(OFILES:.o=.d)

multiplex-dvd-demo-program.s: $(TOOLCHAIN_ROOT)/assets/multiplex-dvd-demo.mpg
	$(SILENTMSG) embedding ... $(notdir $<)
	$(SILENTCMD)bin2s -H multiplex-dvd-demo-program.h $< > $@

multiplex-dvd-demo-program.h: multiplex-dvd-demo-program.s

app.o app_effects.o app_input.o app_jobs.o app_jobs_platform_libogc.o \
	app_jobs_posters.o app_jobs_prefetch.o app_jobs_work.o run.o: media-source.h
app.o: multiplex-dvd-demo-program.h
presentation.o: $(TOOLCHAIN_ROOT)/generated/geist_atlas.h
app_services.o app_services_auth.o app_services_catalog.o \
	app_services_details.o app_services_discovery.o app_services_playback.o \
	app_services_playback_resolution.o app_services_scheduler.o \
	app_services_watch_directory.o \
	app_services_watch_disabled.o app_services_watch_syncplay.o \
	app_services_watch_together.o: media-source.h
http_client.o: media-source.h
tls_client.o: tls-ca.h

media-source.h:
	@echo "Missing $@; run $(BUILD_COMMAND)." >&2
	@false

tls-ca.h:
	@echo "Missing $@; run $(BUILD_COMMAND)." >&2
	@false

$(OUTPUT).dol: $(OUTPUT).elf
$(OUTPUT).elf: $(OFILES) $(CORE_LIBRARY) $(PLATFORM_ELF_DEPS) \
	$(MBEDTLS_ROOT)/lib/libmbedtls.a \
	$(MBEDTLS_ROOT)/lib/libmbedx509.a \
	$(MBEDTLS_ROOT)/lib/libmbedcrypto.a

-include $(DEPENDS)

endif
