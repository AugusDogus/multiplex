@@ -90 +90 @@ pub const max_batched_advance_run_bytes: usize = 32768;
-const generation_needs_atomic = !builtin.target.cpu.arch.isWasm();
+const generation_needs_atomic = !builtin.single_threaded and !builtin.target.cpu.arch.isWasm();
