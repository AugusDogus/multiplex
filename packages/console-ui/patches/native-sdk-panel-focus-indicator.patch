+fn emitPanelFocusIndicator(builder: *Builder, widget: Widget, tokens: DesignTokens) Error!void {
+    const frame = widget.frame.normalized();
+    const height = @max(2, tokens.stroke.focus);
+    const width = @min(32, @max(12, frame.width * 0.22));
+    try builder.fillRoundedRect(.{
+        .id = widgetPartId(widget.id, 4),
+        .rect = geometry.RectF.init(
+            frame.x + (frame.width - width) * 0.5,
+            frame.maxY() + @max(1, tokens.stroke.focus_offset),
+            width,
+            height,
+        ),
+        .radius = Radius.all(height * 0.5),
+        .fill = widgetFocusRingFill(widget, tokens),
+    });
+}
